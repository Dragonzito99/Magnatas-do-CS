# Copie para .env.local. Esse arquivo fica fora do repositório.

# Conexão com o PostgreSQL.
DATABASE_URL=postgres://magnatas:senha@127.0.0.1:5432/magnatas

# Chave do código do CPF, com pelo menos 32 caracteres. Se ela mudar, nenhum CPF antigo é reconhecido.
CPF_HMAC_CHAVE=

# Verificador de identidade. "simulador" só funciona fora de produção.
VERIFICADOR=simulador

# Endereço público do site, sem barra no fim.
SITE_URL=http://localhost:3000

# Token que o servidor de CS2 usa para buscar a lista de liberados.
SERVIDOR_TOKEN=

# Senhas que o site usa para falar com os servidores de CS2 e para dar entrada aos membros.
RCON_SENHA=
SERVIDOR_SENHA=

# Endereço da máquina dos servidores da aba Diversão. Sem ele, os cartões aparecem fora do ar.
DIVERSAO_HOST=
